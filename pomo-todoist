#!/usr/bin/env python3
"""Todoist helper for the pomodoro plugin (Todoist API v1).

  pomo-todoist list [filter]   tasks matching a Todoist filter, as JSON
  pomo-todoist close <task-id> mark a task done

The personal API token is read from ~/.config/uni-pomo/todoist-token
(Todoist: Settings > Integrations > Developer). The file must be a regular
file owned by you and unreadable by anyone else (chmod 600); otherwise it is
refused. The token is never printed or passed on the command line.

Always prints one JSON object and exits 0, so callers can show the error:
  {"ok": true, "tasks": [{"id", "content", "detail"}, ...]}
  {"ok": false, "error": "..."}
Standard library only.
"""

import datetime
import json
import os
import re
import stat
import sys
import urllib.error
import urllib.parse
import urllib.request

API = "https://api.todoist.com/api/v1/"
TOKEN_PATH = os.path.join(os.path.expanduser("~"), ".config", "uni-pomo", "todoist-token")
TASK_ID_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]+")
MAX_PAGES = 3
TIMEOUT = 10


class Fail(Exception):
    pass


def read_token():
    try:
        fd = os.open(TOKEN_PATH, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except FileNotFoundError:
        raise Fail("no token: save it to ~/.config/uni-pomo/todoist-token (see README)")
    except OSError as e:
        raise Fail("token file: %s" % e.strerror)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
            raise Fail("token file must be a regular file you own")
        if st.st_mode & 0o077:
            raise Fail("token file is readable by others: chmod 600 ~/.config/uni-pomo/todoist-token")
        token = os.read(fd, 512).decode("ascii", "replace").strip()
    finally:
        os.close(fd)
    if not re.match(r"^[A-Za-z0-9]{20,100}$", token):
        raise Fail("token file does not look like a Todoist API token")
    return token


def request(token, method, path, params=None):
    url = API + path
    if params:
        url += "?" + urllib.parse.urlencode(params)
    req = urllib.request.Request(url, method=method, headers={
        "Authorization": "Bearer " + token,
        "User-Agent": "omarchy-pomodoro",
    })
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
            body = resp.read(4 * 1024 * 1024)
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            raise Fail("Todoist rejected the token (HTTP %d)" % e.code)
        if e.code == 400:
            raise Fail("Todoist rejected the request (HTTP 400): check the filter")
        raise Fail("Todoist error: HTTP %d" % e.code)
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        raise Fail("can't reach Todoist: %s" % getattr(e, "reason", e))
    return json.loads(body) if body.strip() else {}


def paged(token, path, params):
    items, cursor = [], None
    for _ in range(MAX_PAGES):
        p = dict(params, limit=200)
        if cursor:
            p["cursor"] = cursor
        data = request(token, "GET", path, p)
        items.extend(data.get("results") or [])
        cursor = data.get("next_cursor")
        if not cursor:
            break
    return items


def clean(text, limit=160):
    s = " ".join(CONTROL_RE.sub(" ", str(text or "")).split())
    return s[:limit].strip()


def due_text(due, today):
    if not isinstance(due, dict) or not due.get("date"):
        return "", "9999-99-99"
    day = str(due["date"])[:10]
    try:
        d = datetime.date.fromisoformat(day)
    except ValueError:
        return "", "9999-99-99"
    if d < today:
        return "overdue", day
    if d == today:
        return "today", day
    if d == today + datetime.timedelta(days=1):
        return "tomorrow", day
    return "due " + d.strftime("%b %-d"), day


def list_tasks(filter_query):
    token = read_token()
    tasks = paged(token, "tasks/filter", {"query": filter_query})
    projects = {p.get("id"): p.get("name", "") for p in paged(token, "projects", {})}
    today = datetime.date.today()
    out = []
    for i, t in enumerate(tasks):
        task_id = str(t.get("id") or "")
        content = clean(t.get("content"))
        if not TASK_ID_RE.match(task_id) or not content:
            continue
        due, sort_day = due_text(t.get("due"), today)
        detail = " · ".join(x for x in (clean(projects.get(t.get("project_id"), ""), 60), due) if x)
        out.append((sort_day, i, {"id": task_id, "content": content, "detail": detail}))
    out.sort(key=lambda x: (x[0], x[1]))
    return {"ok": True, "tasks": [x[2] for x in out]}


def close_task(task_id):
    if not TASK_ID_RE.match(task_id or ""):
        raise Fail("bad task id")
    request(read_token(), "POST", "tasks/%s/close" % task_id)
    return {"ok": True}


def main(argv):
    try:
        if argv and argv[0] == "list":
            result = list_tasks(argv[1] if len(argv) > 1 and argv[1].strip() else "today | overdue")
        elif len(argv) == 2 and argv[0] == "close":
            result = close_task(argv[1])
        else:
            result = {"ok": False, "error": "usage: pomo-todoist list [filter] | close <task-id>"}
    except Fail as e:
        result = {"ok": False, "error": str(e)}
    except (ValueError, TypeError):
        result = {"ok": False, "error": "unexpected response from Todoist"}
    print(json.dumps(result, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
